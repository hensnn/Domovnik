# Zkopíruj do deploy/.env (necommituje se) a vyplň. Tajemství vygeneruje deploy/proxmox/bootstrap.sh.
POSTGRES_PASSWORD=
SECRET_KEY=
# Adresa, na které aplikace poběží (název z DNS / mDNS); u interního HTTPS se pro ni vystaví certifikát
DOMOVNIK_HOST=domovnik.local
ADMIN_EMAIL=admin@localhost
# Kam se ukládají data (databáze + fotky) – v LXC samostatný mountpoint
DATA_DIR=/data
# true = cookie jen přes HTTPS (nech true, i za NPM)
COOKIE_SECURE=true
# Režim proxy: /etc/caddy/Caddyfile (vlastní HTTPS, výchozí) nebo /etc/caddy/Caddyfile.http (za Nginx Proxy Managerem)
CADDYFILE=/etc/caddy/Caddyfile
# Při provozu za NPM nastav HTTP_PORT/HTTPS_PORT na volné porty a v NPM míř na PROXY_PORT (8080)
HTTP_PORT=80
HTTPS_PORT=443
PROXY_PORT=8080
